{
  "name": "amazon-seller-agent",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "type": "module",
  "description": "Amazon seller agent: LangGraph.js research + listing workflows",
  "license": "MIT",
  "bin": {
    "asa": "./dist/cli.js"
  },
  "scripts": {
    "asa": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "npm run typecheck --workspace @asa/web",
    "build:web": "npm run build --workspace @asa/web",
    "dev:api": "tsx watch src/server.ts",
    "start:api": "node dist/serve.js",
    "dev:web": "npm run dev --workspace @asa/web",
    "dev:ui": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\""
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "better-sqlite3": "12.11.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "hono": "^4.13.7",
    "sharp": "0.35.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.5",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^2.1.8"
  }
}
