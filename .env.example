AMAZON_MARKETPLACE=us
# Local product records and originals. Use a local disk, not a synced/network folder.
ASA_DATA_DIR=E:\AmazonSellerAgentData
AUTOCOMPLETE_TIMEOUT_MS=15000
AUTOCOMPLETE_DELAY_MS=200

# Optional OpenAI-compatible LLM for listing copy. Leave empty to use templates.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
